# Copy to .env and replace every REQUIRED value. Never commit .env.
# Production must use approved image digests, for example image@sha256:...
POSTGRES_IMAGE=
KEYCLOAK_IMAGE=
OPENFGA_IMAGE=
TEMPORAL_IMAGE=
MINIO_IMAGE=
OTEL_COLLECTOR_IMAGE=

POSTGRES_USER=platform_admin
# These three files contain one secret value each and stay outside version control.
# Compose mounts them read-only; their contents are never interpolated into YAML.
POSTGRES_PASSWORD_FILE=./secrets/postgres_admin_password.txt
SKYVIEW_DB_MIGRATOR_USER=skyview_migrator
SKYVIEW_DB_MIGRATOR_PASSWORD_FILE=./secrets/skyview_db_migrator_password.txt
SKYVIEW_DB_RUNTIME_USER=skyview_runtime
SKYVIEW_DB_RUNTIME_PASSWORD_FILE=./secrets/skyview_db_runtime_password.txt
# SKYVIEW_DB_USER and SKYVIEW_DB_PASSWORD are intentionally unsupported: a
# single owner/runtime identity violates the production least-privilege gate.
KEYCLOAK_DB_USER=keycloak_app
KEYCLOAK_DB_PASSWORD=
OPENFGA_DB_USER=openfga_app
OPENFGA_DB_PASSWORD=
TEMPORAL_DB_USER=temporal_app
TEMPORAL_DB_PASSWORD=

KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=platform-bootstrap-admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=
KEYCLOAK_PUBLIC_URL=https://auth.example.invalid
KEYCLOAK_ADMIN_URL=https://auth-admin.example.invalid
KEYCLOAK_PROXY_TRUSTED_ADDRESSES=
SKYVIEWLAB_WEB_ORIGIN=https://skyview.example.invalid
OIDC_CLIENT_ID=skyviewlab-control-plane
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=https://api.example.invalid/api/v1/auth/oidc/callback
# Go API 专用：32 个随机字节的标准 padded base64，所有副本必须使用同一活动版本。
OIDC_TRANSACTION_KEY=

OPENFGA_PRESHARED_KEYS=
OPENFGA_TLS_CERT_FILE=
OPENFGA_TLS_KEY_FILE=

MINIO_ROOT_USER=platform-object-admin
MINIO_ROOT_PASSWORD=

# Local override ports bind to loopback only.
POSTGRES_LOCAL_PORT=5432
KEYCLOAK_LOCAL_PORT=8180
OPENFGA_HTTP_LOCAL_PORT=8081
OPENFGA_GRPC_LOCAL_PORT=8082
TEMPORAL_LOCAL_PORT=7233
MINIO_LOCAL_PORT=9000
MINIO_CONSOLE_LOCAL_PORT=9001
OTEL_GRPC_LOCAL_PORT=4317
OTEL_HTTP_LOCAL_PORT=4318
