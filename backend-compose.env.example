# Copy to an untracked local file and replace every blank value.
# Never reuse these development values in a deployed environment.
SERVICE_HMAC_SECRET=
# Development adapter only: the API binds this token to this exact worker ID.
WORKER_TOKEN=
WORKER_ID=local-worker-1
# Exact per-slug development capability list; only executionAllowed catalog slugs are accepted.
WORKER_CAPABILITIES_JSON=[{"slug":"paper-writing","actions":["outline","audit"]}]

DEV_ADMIN_ACCOUNT=
DEV_ADMIN_PASSWORD=
DEV_STUDENT_ACCOUNT=
DEV_STUDENT_PASSWORD=

DEV_TENANT_ID=tenant-local
DEV_WORKSPACE_ID=workspace-local
CORS_ORIGINS=http://localhost:4182,http://127.0.0.1:4182
# Transitional synchronous bridge only; 1s..8m. Longer jobs require Temporal.
PYTHON_REQUEST_TIMEOUT=30s
JOB_TERMINAL_PERSIST_TIMEOUT=30s
