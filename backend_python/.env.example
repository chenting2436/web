PYTHON_HOST=127.0.0.1
PYTHON_PORT=8000
CORS_ORIGINS=http://localhost:4182,http://127.0.0.1:4182
APP_ENV=production
TRUSTED_SERVICE_ID=go-control-plane
SERVICE_HMAC_SECRET=
SERVICE_SIGNATURE_MAX_AGE_SECONDS=300
ALLOW_UNSIGNED_DEV_REQUESTS=false
ALLOW_UNSAFE_LOCAL_CODE_EXECUTION=false
MAX_REQUEST_BYTES=1048576
MAX_JSON_DEPTH=16
MAX_JSON_ARRAY_ITEMS=5000
MAX_JSON_STRING_LENGTH=200000
# Optional isolated code runner for AI Assessment. Production endpoints must use HTTPS;
# plain HTTP is accepted only for localhost development runners.
JUDGE0_API_URL=
JUDGE0_AUTH_HEADER=
JUDGE0_AUTH_TOKEN=
# Optional licensed FLAC3D compute node. The executable path is server-owned;
# browser payloads can never override it. Keep execution disabled until the
# host, license and output directory have been verified.
FLAC3D_BENCHMARK_DIRECTORY=
FLAC3D_CONSOLE_PATH=
FLAC3D_RUN_ROOT=
FLAC3D_EXECUTION_TIMEOUT_SECONDS=420
ALLOW_FLAC3D_EXECUTION=false
