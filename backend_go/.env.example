GO_API_ADDRESS=127.0.0.1:8080
CORS_ORIGINS=http://localhost:4182,http://127.0.0.1:4182
PYTHON_SERVICE_URL=http://127.0.0.1:8000
PYTHON_ALLOW_INSECURE_HTTP=true
PYTHON_REQUEST_TIMEOUT=30s
JOB_TERMINAL_PERSIST_TIMEOUT=30s
PYTHON_SERVICE_ID=go-control-plane
SERVICE_HMAC_SECRET=
# Development only. These values must be provided together; the token is
# authenticated as this exact server-controlled worker identity.
WORKER_TOKEN=
WORKER_ID=local-worker-1
GO_CONTROL_PLANE_URL=http://127.0.0.1:8080
WORKER_CAPABILITIES_JSON=[{"slug":"paper-writing","actions":["audit"]}]
WORKER_CREDENTIALS_FILE=

# Development/test only. Production must use postgresql and DEV_MODE=false.
DEV_MODE=true
DEV_AUTHORIZATION_FALLBACK=true
DEV_TENANT_ID=tenant-local
DEV_WORKSPACE_ID=workspace-local
DATABASE_ADAPTER=sqlite-development
DATABASE_FILE=./data/skyviewlab.db
DATABASE_URL=
DATABASE_MIGRATE=false
DEMO_ACCOUNT=
DEMO_PASSWORD=
STUDENT_ACCOUNT=
STUDENT_PASSWORD=
COOKIE_SECURE=false
OIDC_MAX_TOKEN_LIFETIME=1h
OIDC_ALLOW_INSECURE_HTTP=false
# Standard padded base64 for exactly 32 cryptographically random bytes.
# Optional only when DEV_MODE=true; production replicas must share one value.
OIDC_TRANSACTION_KEY=
OPENFGA_TIMEOUT=2s
OPENFGA_ALLOW_INSECURE_HTTP=false

# Production contract example. Provide every secret through a secret manager,
# clear DATABASE_FILE and development accounts, and disable the local fallback.
# DEV_MODE=false
# DEV_AUTHORIZATION_FALLBACK=false
# CORS_ORIGINS=https://app.example.com
# DATABASE_ADAPTER=postgresql
# DATABASE_URL=postgresql://skyview_runtime@db.internal/skyviewlab?sslmode=verify-full&options=-csearch_path%3Dpg_catalog%2Cpublic
# DATABASE_FILE=
# DATABASE_MIGRATE=false
# COOKIE_SECURE=true
# PYTHON_SERVICE_URL=https://compute.internal.example.com
# PYTHON_ALLOW_INSECURE_HTTP=false
# PYTHON_REQUEST_TIMEOUT=30s
# JOB_TERMINAL_PERSIST_TIMEOUT=30s
# OIDC_ISSUER_URL=https://auth.example.com/realms/skyviewlab
# OIDC_CLIENT_ID=skyviewlab-control-plane
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URL=https://api.example.com/api/v1/auth/oidc/callback
# OIDC_WEB_RETURN_URL=https://app.example.com/auth/complete
# OIDC_TENANT_CLAIM=tenant_id
# OIDC_WORKSPACE_CLAIM=workspace_id
# OIDC_MAX_TOKEN_LIFETIME=1h
# OIDC_ALLOW_INSECURE_HTTP=false
# OIDC_TRANSACTION_KEY=<secret-manager base64 value for exactly 32 random bytes>
# WORKER_CREDENTIALS_FILE=/run/secrets/skyviewlab-worker-credentials.json
# GO_CONTROL_PLANE_URL=https://api.internal.example.com
# WORKER_ID=
# WORKER_TOKEN=
# WORKER_CAPABILITIES_JSON=
# OPENFGA_API_URL=https://openfga.internal.example.com
# OPENFGA_STORE_ID=
# OPENFGA_AUTHORIZATION_MODEL_ID=
# OPENFGA_API_TOKEN=
# OPENFGA_MODEL_SHA256=
# OPENFGA_TIMEOUT=2s
# OPENFGA_ALLOW_INSECURE_HTTP=false
