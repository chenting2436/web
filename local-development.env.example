# Copy this file to .env.backend and fill every required local value.
# The resulting .env.backend is ignored by Git. Never commit real credentials.

SKYVIEW_LOCAL_DEMO_ACCOUNT=
SKYVIEW_LOCAL_DEMO_PASSWORD=

# Optional student login. Either fill both values or leave both blank.
SKYVIEW_LOCAL_STUDENT_ACCOUNT=
SKYVIEW_LOCAL_STUDENT_PASSWORD=
